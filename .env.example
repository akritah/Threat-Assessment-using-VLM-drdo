OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
FRAME_COUNT=6
OUTPUT_DIR=outputs

# Optional: HuggingFace Hub token (required for gated models like Gemma 3)
HF_TOKEN=

# Optional: HuggingFace + QLoRA adapter inference (default backend is ollama)
INFERENCE_BACKEND=ollama
ACTIVE_ADAPTER=
HF_BASE_MODEL_ID=google/gemma-3-4b-it
HF_BASE_MODEL_PATH=models/gemma_base
ADAPTERS_DIR=adapters
ADAPTER_CONFIG_PATH=config/adapter_config.yaml
TRAINING_CONFIG_PATH=config/training_config.yaml
